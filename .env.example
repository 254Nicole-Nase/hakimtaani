# Supabase (VITE_* values are inlined at build time, so they must be set for the build too)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# AI provider: the first one configured is used.
# 1. Azure OpenAI (Imagine Cup target)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
# 2. Google Gemini: lets the app run outside Lovable (e.g. on Vercel)
GOOGLE_API_KEY=
# Optional, defaults to gemini-3.7-flash
GOOGLE_AI_MODEL=
# 3. Lovable AI Gateway: only works inside Lovable
LOVABLE_API_KEY=

# Optional Azure services
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
